# Server runtime
NODE_ENV=development
PORT=5000

# MongoDB connection
# Production: required. Development falls back to mongodb://localhost:27017/quanbao when unset.
MONGODB_URI=mongodb://localhost:27017/quanbao

# JWT secret
# Required in production and must be at least 32 characters.
JWT_SECRET=replace-with-at-least-32-character-secret

# Origin configuration
# Development examples:
CLIENT_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:5000
API_URL=http://localhost:5000
#
# Production requirements:
# - CLIENT_URL is required and must be the exact HTTPS frontend origin allowed by
#   credentialed CORS, CSRF origin checks, and production CSP.
#   Example: https://www.example.com
# - API_PUBLIC_URL is required and must be the exact HTTPS public API origin used by
#   browsers, reverse proxies, and CSP.
#   Example: https://api.example.com
# - API_URL is optional. If set, it must use the same origin as API_PUBLIC_URL.
#   Example: https://api.example.com/api
# - Do not use wildcard origins, localhost, HTTP, trailing slashes, paths, query
#   strings, or hashes for CLIENT_URL or API_PUBLIC_URL in production.
# - Client NEXT_PUBLIC_SITE_URL must exactly match CLIENT_URL.
# - Client NEXT_PUBLIC_API_URL must use API_PUBLIC_URL plus /api.
#   Example: https://api.example.com/api

# Cloudinary image uploads
# Production: required unless CLOUDINARY_ENABLED=false.
CLOUDINARY_ENABLED=true
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Request body limits
# Optional. Defaults are 1mb.
JSON_BODY_LIMIT=1mb
URLENCODED_BODY_LIMIT=1mb

# Auth and local test toggles
# DISABLE_DB_CONNECT=true is for isolated server tests only.
# ALLOW_AUTH_HEADER=true permits Bearer-token fallback in production; leave false unless a trusted
# internal client needs it. Non-production allows the fallback automatically.
DISABLE_DB_CONNECT=false
ALLOW_AUTH_HEADER=false

# Admin seeding
# Used by node seed.js. ADMIN_PASSWORD must be at least 10 characters and include
# uppercase, lowercase, and a number. Leave unset to skip admin creation.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ReplaceWithStrongAdmin1
ADMIN_NAME=Admin Quan Bao

# CMS URL allowlists (comma-separated hostnames)
CMS_ALLOWED_IMAGE_HOSTS=res.cloudinary.com,images.unsplash.com,www.cc1.vn,m.media-amazon.com
CMS_ALLOWED_LINK_HOSTS=res.cloudinary.com,images.unsplash.com,www.cc1.vn,m.media-amazon.com,facebook.com,www.facebook.com,zalo.me,youtube.com,www.youtube.com,youtu.be
