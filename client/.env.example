# Public site origin used by metadata, canonical URLs, robots, and sitemap.
# Production: required, exact HTTPS origin, no path or trailing slash.
# Must match server CLIENT_URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public API base URL used by browser requests.
# Production: required, exact server API_PUBLIC_URL plus /api.
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Extra approved CMS image hostnames, comma-separated.
# Keep aligned with server CMS_ALLOWED_IMAGE_HOSTS and Next image remotePatterns.
NEXT_PUBLIC_CMS_ALLOWED_IMAGE_HOSTS=res.cloudinary.com,images.unsplash.com,www.cc1.vn,m.media-amazon.com
