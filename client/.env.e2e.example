# Playwright base URLs.
E2E_BASE_URL=http://localhost:3000
E2E_API_URL=http://localhost:5050/api
NEXT_PUBLIC_API_URL=http://localhost:5050/api

# Required for tests that create, publish, update, or delete persisted data.
# E2E_DATABASE_LABEL must clearly identify a local/e2e/test database and must not
# look like production/live data.
E2E_RUN_DESTRUCTIVE=false
E2E_DATABASE_LABEL=local-e2e

# Admin E2E credentials. These should match the test admin created with the server
# ADMIN_EMAIL and ADMIN_PASSWORD seeding variables.
ADMIN_E2E_EMAIL=admin@quanbao.com
ADMIN_E2E_PASSWORD=replace-with-e2e-admin-password
